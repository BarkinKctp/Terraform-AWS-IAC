# Optional override: the default from variables.tf is already eu-west-1.
# Uncomment only if you want a different region.
# aws_region = "eu-west-1"

# Required values for this project:
app_bucket_name = "<your-unique-app-bucket-name>"
db_name         = "<your-database-name>"
db_username     = "<your-database-username>"
db_password     = "<your-database-password>"

# Optional override for accounts/regions where some sizes are restricted:
# ec2_instance_type = "t3.micro"
