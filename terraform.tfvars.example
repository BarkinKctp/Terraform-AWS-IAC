# Required values for this project:
app_bucket_name = "<your-unique-app-bucket-name>"
db_name         = "<your-database-name>"
db_username     = "<your-database-username>"
db_password     = "<your-database-password>"

# Optional overrides (defaults shown):
# aws_region        = "eu-west-1"
# ec2_instance_type = "t3.micro"

# To list available instance types in your region:
# aws ec2 describe-instance-type-offerings \
#   --location-type availability-zone \
#   --filters 'Name=instance-type,Values=t3.*' \
#   --region eu-west-1 \
#   --query 'InstanceTypeOfferings[].InstanceType' \
#   --output table
#
# Some regions and availability zones have different instance type availability.